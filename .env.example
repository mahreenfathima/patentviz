# Required: story, layout and narration (Gemini)
GEMINI_API_KEY=your_api_key_here
GEMINI_API_KEY_2=your_api_key_here
GEMINI_API_KEY_3=your_api_key_here
GEMINI_API_KEY_4=your_api_key_here

# Optional: real search data for the story (free tier: 250 searches/month)
SERPAPI_API_KEY=your_api_key_here

GROQ_API_KEY=your_api_key_here


# Optional: Pollinations works without a key. A free key removes the watermark and throttle.

# Optional: narration voice (default Kore). Check the voice list for gemini-3.8-flash-tts.
# GEMINI_TTS_VOICE=Kore

# Optional model overrides
# VOX_MODEL=gemini-3.5-flash
# VOX_TTS_MODEL=gemini-3.8-flash-tts

# Optional: background removal for cutouts (rembg, MIT, runs locally, free).
# Install once: pip install "rembg[cpu,cli]"  (Python 3.11-3.13). Set VOX_REMBG=0 to turn it off.
# REMBG_BIN=rembg
# REMBG_MODEL=isnet-general-use
# VOX_REMBG=1
